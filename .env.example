# Copie para .env (local) ou cadastre no Render → Environment.
NODE_ENV=production
BASE_URL=https://seu-dominio.com.br
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Segredo dos logins (gere um texto aleatório longo)
JWT_SECRET=troque-por-um-texto-aleatorio-com-mais-de-24-caracteres

# Login do painel admin (/admin)
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=uma-senha-forte-e-longa

# E-mails (Resend)
RESEND_API_KEY=
EMAIL_FROM=VARG <noreply@seu-dominio.com.br>
EMAIL_ADMIN=voce@exemplo.com

# PIX: pixgo ou braspay
PIX_PROVIDER=pixgo
PIXGO_API_KEY=
PIXGO_WEBHOOK_SECRET=

# Opcionais: deixe vazio para esconder a opção no checkout
CRYPTO_WALLET=
CRYPTO_NETWORK=Polygon
WHATSAPP_PHONE=5512999999999
CALLMEBOT_APIKEY=

# Frete fixo em R$ (0 = grátis) e frete grátis a partir de (0 = desligado)
FRETE_FIXO=0
FRETE_GRATIS_ACIMA=0
